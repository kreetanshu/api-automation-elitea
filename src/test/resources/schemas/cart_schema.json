{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cart",
  "type": "object",
  "additionalProperties": true,
  "required": ["id"],
  "properties": {
    "id": { "type": "number" },
    "userId": { "type": "number" },
    "date": { "type": "string" },
    "products": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "productId": { "type": "number" },
          "quantity": { "type": "number" }
        }
      }
    }
  }
}
