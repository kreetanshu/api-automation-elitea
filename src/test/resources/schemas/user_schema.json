{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "User",
  "type": "object",
  "additionalProperties": true,
  "required": ["id"],
  "properties": {
    "id": { "type": "number" },
    "email": { "type": "string" },
    "username": { "type": "string" },
    "password": { "type": "string" },
    "name": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "firstname": { "type": "string" },
        "lastname": { "type": "string" }
      }
    },
    "address": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "city": { "type": "string" },
        "street": { "type": "string" },
        "number": { "type": ["number", "integer"] },
        "zipcode": { "type": "string" },
        "geolocation": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "lat": { "type": "string" },
            "long": { "type": "string" }
          }
        }
      }
    },
    "phone": { "type": "string" }
  }
}
