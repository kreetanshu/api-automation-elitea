{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Product",
  "type": "object",
  "additionalProperties": true,
  "required": ["id"],
  "properties": {
    "id": { "type": "number" },
    "title": { "type": "string" },
    "price": { "type": "number" },
    "description": { "type": "string" },
    "category": { "type": "string" },
    "image": { "type": "string" },
    "rating": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "rate": { "type": "number" },
        "count": { "type": "number" }
      }
    }
  }
}
