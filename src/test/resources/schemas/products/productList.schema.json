{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProductList",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": true,
    "required": ["id", "title", "price"],
    "properties": {
      "id": { "type": "number" },
      "title": { "type": "string" },
      "price": { "type": "number" },
      "description": { "type": "string" },
      "category": { "type": "string" },
      "image": { "type": "string" },
      "rating": {
        "type": "object",
        "additionalProperties": true,
        "required": ["rate", "count"],
        "properties": {
          "rate": { "type": "number" },
          "count": { "type": "number" }
        }
      }
    }
  }
}
